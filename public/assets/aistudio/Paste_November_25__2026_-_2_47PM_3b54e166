## 5. Modern Material 3 UI (`MainActivity.kt`)

Features an athletic dark OLED palette (`#0D0F12`), neon emerald performance accents (`#00E676`), bottom navigation, live rest timer banner, and interactive supplement/macro controls.

```kotlin
package com.apexform.app

import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.lifecycle.viewmodel.compose.viewModel
import com.apexform.app.data.ExerciseEntity
import com.apexform.app.data.SupplementEntity
import com.apexform.app.viewmodel.GymUiState
import com.apexform.app.viewmodel.GymViewModel

private val DarkBg = Color(0xFF0D0F12)
private val CardBg = Color(0xFF171A21)
private val AccentGreen = Color(0xFF00E676)
private val AccentOrange = Color(0xFFFF6D00)
private val TextPrimary = Color(0xFFF4F6F8)
private val TextMuted = Color(0xFF9AA4B2)

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent {
            MaterialTheme(
                colorScheme = darkColorScheme(
                    background = DarkBg,
                    surface = CardBg,
                    primary = AccentGreen,
                    secondary = AccentOrange
                )
            ) {
                ApexFormApp()
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ApexFormApp(viewModel: GymViewModel = viewModel()) {
    val state by viewModel.uiState.collectAsState()
    var selectedTab by remember { mutableIntStateOf(0) }

    Scaffold(
        containerColor = DarkBg,
        topBar = {
            TopAppBar(
                title = {
                    Text(
                        text = "APEXFORM",
                        fontWeight = FontWeight.ExtraBold,
                        letterSpacing = 2.sp,
                        color = AccentGreen
                    )
                },
                colors = TopAppBarDefaults.topAppBarColors(containerColor = DarkBg)
            )
        },
        bottomBar = {
            NavigationBar(containerColor = CardBg) {
                NavigationBarItem(
                    selected = selectedTab == 0,
                    onClick = { selectedTab = 0 },
                    icon = { Icon(Icons.Default.Dashboard, "Dashboard") },
                    label = { Text("Overview") }
                )
                NavigationBarItem(
                    selected = selectedTab == 1,
                    onClick = { selectedTab = 1 },
                    icon = { Icon(Icons.Default.FitnessCenter, "Workout") },
                    label = { Text("Training") }
                )
                NavigationBarItem(
                    selected = selectedTab == 2,
                    onClick = { selectedTab = 2 },
                    icon = { Icon(Icons.Default.Medication, "Supplements") },
                    label = { Text("Stack") }
                )
            }
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(horizontal = 16.dp)
        ) {
            if (state.isTimerRunning) {
                RestTimerBanner(
                    secondsLeft = state.restSecondsRemaining,
                    onStop = { viewModel.stopRestTimer() }
                )
                Spacer(modifier = Modifier.height(12.dp))
            }

            when (selectedTab) {
                0 -> DashboardScreen(
                    state = state,
                    onAddWater = { viewModel.addWater() },
                    onAddProtein = { viewModel.addProtein() }
                )
                1 -> WorkoutScreen(
                    exercises = state.exercises,
                    onCompleteSet = { viewModel.logSetCompleted(it) }
                )
                2 -> SupplementScreen(
                    supplements = state.supplements,
                    onToggle = { viewModel.toggleSupplement(it) }
                )
            }
        }
    }
}

@Composable
fun RestTimerBanner(secondsLeft: Int, onStop: () -> Unit) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(14.dp))
            .background(AccentOrange.copy(alpha = 0.2f))
            .padding(horizontal = 16.dp, vertical = 12.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.SpaceBetween
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Icon(Icons.Default.Timer, contentDescription = null, tint = AccentOrange)
            Spacer(modifier = Modifier.width(8.dp))
            Text(
                text = "Rest Timer: ${secondsLeft}s",
                color = TextPrimary,
                fontWeight = FontWeight.Bold,
                fontSize = 16.sp
            )
        }
        TextButton(onClick = onStop) {
            Text("SKIP", color = AccentOrange, fontWeight = FontWeight.Bold)
        }
    }
}

@Composable
fun DashboardScreen(
    state: GymUiState,
    onAddWater: () -> Unit,
    onAddProtein: () -> Unit
) {
    val nutrition = state.nutrition
    val takenSupps = state.supplements.count { it.isTakenToday }
    val totalSetsDone = state.exercises.sumOf { it.completedSets }
    val totalSetsTarget = state.exercises.sumOf { it.targetSets }

    LazyColumn(verticalArrangement = Arrangement.spacedBy(14.dp)) {
        item {
            Text(
                text = "Daily Performance",
                fontSize = 22.sp,
                fontWeight = FontWeight.Bold,
                color = TextPrimary
            )
        }

        // Nutrition & Protein Card
        item {
            Card(
                colors = CardDefaults.cardColors(containerColor = CardBg),
                shape = RoundedCornerShape(16.dp)
            ) {
                Column(modifier = Modifier.padding(16.dp)) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween
                    ) {
                        Text("Calories & Protein", fontWeight = FontWeight.Bold, color = TextPrimary)
                        Text(
                            "${nutrition.caloriesConsumed} / ${nutrition.caloriesTarget} kcal",
                            color = AccentGreen,
                            fontWeight = FontWeight.SemiBold
                        )
                    }
                    Spacer(modifier = Modifier.height(10.dp))
                    LinearProgressIndicator(
                        progress = {
                            (nutrition.proteinGrams.toFloat() / nutrition.proteinTarget)
                                .coerceIn(0f, 1f)
                        },
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(8.dp)
                            .clip(RoundedCornerShape(4.dp)),
                        color = AccentGreen,
                        trackColor = DarkBg
                    )
                    Spacer(modifier = Modifier.height(8.dp))
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            "Protein: ${nutrition.proteinGrams}g / ${nutrition.proteinTarget}g",
                            color = TextMuted,
                            fontSize = 13.sp
                        )
                        FilledTonalButton(onClick = onAddProtein) {
                            Text("+25g Shake")
                        }
                    }
                }
            }
        }

        // Hydration Card
        item {
            Card(
                colors = CardDefaults.cardColors(containerColor = CardBg),
                shape = RoundedCornerShape(16.dp)
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(16.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Column {
                        Text("Hydration", fontWeight = FontWeight.Bold, color = TextPrimary)
                        Text(
                            "${nutrition.waterMl} / ${nutrition.waterTargetMl} ml",
                            color = TextMuted,
                            fontSize = 14.sp
                        )
                    }
                    Button(
                        onClick = onAddWater,
                        colors = ButtonDefaults.buttonColors(containerColor = AccentGreen)
                    ) {
                        Text("+250 ml", color = DarkBg, fontWeight = FontWeight.Bold)
                    }
                }
            }
        }

        // Readiness Summary
        item {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                SummaryStatCard(
                    modifier = Modifier.weight(1f),
                    title = "Sets Done",
                    value = "$totalSetsDone / $totalSetsTarget"
                )
                SummaryStatCard(
                    modifier = Modifier.weight(1f),
                    title = "Supplements",
                    value = "$takenSupps / ${state.supplements.size}"
                )
            }
        }
    }
}

@Composable
fun SummaryStatCard(modifier: Modifier, title: String, value: String) {
    Card(
        modifier = modifier,
        colors = CardDefaults.cardColors(containerColor = CardBg),
        shape = RoundedCornerShape(16.dp)
    ) {
        Column(modifier = Modifier.padding(16.dp)) {
            Text(title, color = TextMuted, fontSize = 13.sp)
            Spacer(modifier = Modifier.height(6.dp))
            Text(value, color = TextPrimary, fontSize = 22.sp, fontWeight = FontWeight.Bold)
        }
    }
}

@Composable
fun WorkoutScreen(
    exercises: List<ExerciseEntity>,
    onCompleteSet: (Int) -> Unit
) {
    LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp)) {
        item {
            Text(
                text = "Gymnastics & Strength Routine",
                fontSize = 22.sp,
                fontWeight = FontWeight.Bold,
                color = TextPrimary
            )
        }
        items(exercises, key = { it.id }) { ex ->
            val isDone = ex.completedSets >= ex.targetSets
            Card(
                colors = CardDefaults.cardColors(containerColor = CardBg),
                shape = RoundedCornerShape(16.dp)
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(16.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Column(modifier = Modifier.weight(1f)) {
                        Text(ex.category.uppercase(), color = AccentGreen, fontSize = 11.sp)
                        Text(
                            ex.name,
                            color = TextPrimary,
                            fontWeight = FontWeight.Bold,
                            fontSize = 17.sp
                        )
                        val loadText = if (ex.weightKg > 0f) " • ${ex.weightKg} kg" else ""
                        Text(
                            "${ex.targetSets} sets × ${ex.targetRepsOrSec}$loadText",
                            color = TextMuted,
                            fontSize = 13.sp
                        )
                    }
                    Button(
                        onClick = { onCompleteSet(ex.id) },
                        colors = ButtonDefaults.buttonColors(
                            containerColor = if (isDone) AccentGreen else DarkBg
                        )
                    ) {
                        Text(
                            text = "${ex.completedSets}/${ex.targetSets}",
                            color = if (isDone) DarkBg else AccentGreen,
                            fontWeight = FontWeight.Bold
                        )
                    }
                }
            }
        }
    }
}

@Composable
fun SupplementScreen(
    supplements: List<SupplementEntity>,
    onToggle: (Int) -> Unit
) {
    val grouped = supplements.groupBy { it.timing }

    LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp)) {
        item {
            Text(
                text = "Daily Supplement Stack",
                fontSize = 22.sp,
                fontWeight = FontWeight.Bold,
                color = TextPrimary
            )
        }
        grouped.forEach { (timing, list) ->
            item {
                Text(
                    text = timing.label.uppercase(),
                    color = AccentOrange,
                    fontWeight = FontWeight.Bold,
                    fontSize = 12.sp,
                    modifier = Modifier.padding(top = 6.dp)
                )
            }
            items(list, key = { it.id }) { sup ->
                Card(
                    modifier = Modifier.clickable { onToggle(sup.id) },
                    colors = CardDefaults.cardColors(containerColor = CardBg),
                    shape = RoundedCornerShape(14.dp)
                ) {
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(14.dp),
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.SpaceBetween
                    ) {
                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Checkbox(
                                checked = sup.isTakenToday,
                                onCheckedChange = { onToggle(sup.id) },
                                colors = CheckboxDefaults.colors(checkedColor = AccentGreen)
                            )
                            Spacer(modifier = Modifier.width(8.dp))
                            Column {
                                Text(
                                    sup.name,
                                    color = TextPrimary,
                                    fontWeight = FontWeight.SemiBold
                                )
                                Text(
                                    "${sup.dosage} • ${sup.servingsLeft} servings left",
                                    color = if (sup.servingsLeft <= 15) AccentOrange else TextMuted,
                                    fontSize = 12.sp
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

