## 3. Data Layer & Room Database (`data/GymModels.kt`)

This layer defines the database schema for exercises, supplements, and daily nutrition metrics.

```kotlin
package com.apexform.app.data

import androidx.room.*
import kotlinx.coroutines.flow.Flow

enum class SupplementTiming(val label: String) {
    MORNING("Morning"),
    PRE_WORKOUT("Pre-Workout"),
    POST_WORKOUT("Post-Workout"),
    NIGHT("Before Bed")
}

@Entity(tableName = "exercises")
data class ExerciseEntity(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val name: String,
    val category: String,      // e.g., "Gymnastics", "Push", "Pull"
    val targetSets: Int,
    val targetRepsOrSec: String, // e.g., "10 reps" or "45s hold"
    val weightKg: Float = 0f,
    val completedSets: Int = 0
)

@Entity(tableName = "supplements")
data class SupplementEntity(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val name: String,
    val dosage: String,
    val timing: SupplementTiming,
    val isTakenToday: Boolean = false,
    val servingsLeft: Int = 30
)

data class DailyNutrition(
    val caloriesConsumed: Int = 1850,
    val caloriesTarget: Int = 2600,
    val proteinGrams: Int = 135,
    val proteinTarget: Int = 175,
    val waterMl: Int = 2000,
    val waterTargetMl: Int = 3500
)

@Dao
interface GymDao {
    @Query("SELECT * FROM exercises")
    fun getAllExercises(): Flow<List<ExerciseEntity>>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun upsertExercise(exercise: ExerciseEntity)

    @Query("SELECT * FROM supplements")
    fun getAllSupplements(): Flow<List<SupplementEntity>>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun upsertSupplement(supplement: SupplementEntity)
}

@Database(
    entities = [ExerciseEntity::class, SupplementEntity::class],
    version = 1,
    exportSchema = false
)
abstract class GymDatabase : RoomDatabase() {
    abstract fun gymDao(): GymDao
}

