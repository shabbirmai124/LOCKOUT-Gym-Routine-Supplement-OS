## 4. State & Business Logic (`viewmodel/GymViewModel.kt`)

Manages reactive UI state, live workout rest timer countdown, supplement toggling (with automatic serving deduction), and hydration/protein updates.

```kotlin
package com.apexform.app.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.apexform.app.data.*
import kotlinx.coroutines.Job
import kotlinx.coroutines.delay
import kotlinx.coroutines.flow.*
import kotlinx.coroutines.launch

data class GymUiState(
    val exercises: List<ExerciseEntity> = emptyList(),
    val supplements: List<SupplementEntity> = emptyList(),
    val nutrition: DailyNutrition = DailyNutrition(),
    val restSecondsRemaining: Int = 0,
    val isTimerRunning: Boolean = false
)

class GymViewModel : ViewModel() {

    private val _uiState = MutableStateFlow(
        GymUiState(
            exercises = defaultExercises(),
            supplements = defaultSupplements()
        )
    )
    val uiState: StateFlow<GymUiState> = _uiState.asStateFlow()

    private var timerJob: Job? = null

    fun logSetCompleted(exerciseId: Int) {
        _uiState.update { state ->
            val updated = state.exercises.map { ex ->
                if (ex.id == exerciseId) {
                    val nextSet = if (ex.completedSets < ex.targetSets) {
                        ex.completedSets + 1
                    } else 0
                    ex.copy(completedSets = nextSet)
                } else ex
            }
            state.copy(exercises = updated)
        }
        startRestTimer(60)
    }

    fun startRestTimer(seconds: Int) {
        timerJob?.cancel()
        timerJob = viewModelScope.launch {
            _uiState.update {
                it.copy(restSecondsRemaining = seconds, isTimerRunning = true)
            }
            var remaining = seconds
            while (remaining > 0) {
                delay(1000L)
                remaining--
                _uiState.update { it.copy(restSecondsRemaining = remaining) }
            }
            _uiState.update { it.copy(isTimerRunning = false) }
        }
    }

    fun stopRestTimer() {
        timerJob?.cancel()
        _uiState.update {
            it.copy(restSecondsRemaining = 0, isTimerRunning = false)
        }
    }

    fun toggleSupplement(supplementId: Int) {
        _uiState.update { state ->
            val updated = state.supplements.map { sup ->
                if (sup.id == supplementId) {
                    val nowTaken = !sup.isTakenToday
                    val newStock = if (nowTaken) {
                        (sup.servingsLeft - 1).coerceAtLeast(0)
                    } else {
                        sup.servingsLeft + 1
                    }
                    sup.copy(isTakenToday = nowTaken, servingsLeft = newStock)
                } else sup
            }
            state.copy(supplements = updated)
        }
    }

    fun addWater(amountMl: Int = 250) {
        _uiState.update { state ->
            val current = state.nutrition
            state.copy(
                nutrition = current.copy(waterMl = current.waterMl + amountMl)
            )
        }
    }

    fun addProtein(grams: Int = 25, calories: Int = 120) {
        _uiState.update { state ->
            val current = state.nutrition
            state.copy(
                nutrition = current.copy(
                    proteinGrams = current.proteinGrams + grams,
                    caloriesConsumed = current.caloriesConsumed + calories
                )
            )
        }
    }

    private fun defaultExercises() = listOf(
        ExerciseEntity(1, "Ring Muscle-Up", "Gymnastics", 4, "5 reps", 0f),
        ExerciseEntity(2, "Freestanding Handstand", "Gymnastics", 4, "45s hold", 0f),
        ExerciseEntity(3, "Weighted Dips", "Strength", 4, "8 reps", 20f),
        ExerciseEntity(4, "L-Sit on Parallettes", "Core", 3, "30s hold", 0f),
        ExerciseEntity(5, "Barbell Back Squat", "Legs", 4, "8 reps", 90f)
    )

    private fun defaultSupplements() = listOf(
        SupplementEntity(1, "Vitamin D3 + K2", "5000 IU", SupplementTiming.MORNING, false, 42),
        SupplementEntity(2, "Omega-3 Fish Oil", "2000 mg", SupplementTiming.MORNING, false, 28),
        SupplementEntity(3, "L-Citrulline Malate", "6 g", SupplementTiming.PRE_WORKOUT, false, 18),
        SupplementEntity(4, "Whey Protein Isolate", "30 g", SupplementTiming.POST_WORKOUT, false, 24),
        SupplementEntity(5, "Creatine Monohydrate", "5 g", SupplementTiming.POST_WORKOUT, false, 55),
        SupplementEntity(6, "Magnesium Glycinate", "400 mg", SupplementTiming.NIGHT, false, 12)
    )
}

