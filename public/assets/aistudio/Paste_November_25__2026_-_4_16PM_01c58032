                    2 -> SupplementStackTab(
                        supplements = supplements,
                        warnings = supplementWarnings,
                        onToggle = { id ->
                            haptic.performHapticFeedback(HapticFeedbackType.LongPress)
                            supplements = supplements.map { s ->
                                if (s.id == id) {
                                    val nextTaken = !s.takenToday
                                    val nextStock = if (nextTaken) (s.servingsLeft - 1).coerceAtLeast(0) else s.servingsLeft + 1
                                    s.copy(takenToday = nextTaken, servingsLeft = nextStock)
                                } else s
                            }
                        }
                    )
                    3 -> GymVaultTab(
                        items = vaultItems,
                        onToggleOwned = { id ->
                            vaultItems = vaultItems.map {
                                if (it.id == id) it.copy(inMyGearBag = !it.inMyGearBag) else it
                            }
                        }
                    )
                    4 -> PerformanceLabsTab(exercises = exercises)
                }
            }
        }

        // Modal 1: Visual Barbell Plate Calculator
        plateCalcWeight?.let { weight ->
            val load = LockoutIntelligenceEngine.calculatePlatesPerSide(weight)
            val warmup = LockoutIntelligenceEngine.generateWarmupRamp(weight)
            AlertDialog(
                containerColor = LockoutColors.Surface2,
                onDismissRequest = { plateCalcWeight = null },
                title = { Text("Barbell Loader (${weight} kg)", color = LockoutColors.Volt) },
                text = {
                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                        Text(
                            "Load PER SIDE (20 kg bar):",
                            color = LockoutColors.TextSecondary,
                            fontSize = 13.sp
                        )
                        Text(
                            text = if (load.platesPerSide.isEmpty()) "Empty Olympic Bar"
                            else load.platesPerSide.joinToString(" + ") { "${it}kg" },
                            color = LockoutColors.TextPrimary,
                            fontWeight = FontWeight.Bold,
                            fontSize = 17.sp
                        )
                        HorizontalDivider(color = LockoutColors.Border)
                        Text("Auto Warm-Up Ramp:", color = LockoutColors.Cyan, fontWeight = FontWeight.Bold)
                        warmup.forEachIndexed { idx, (w, r) ->
                            Text("Warm-Up ${idx + 1}: $w kg × $r reps", color = LockoutColors.TextPrimary, fontSize = 13.sp)
                        }
                    }
                },
                confirmButton = {
                    TextButton(onClick = { plateCalcWeight = null }) { Text("DONE", color = LockoutColors.Volt) }
                }
            )
        }

        // Modal 2: 1-Tap Smart Equipment Swapper
        swapTargetExercise?.let { target ->
            val swaps = LockoutIntelligenceEngine.suggestSwaps(target.name, activeProfile)
            AlertDialog(
                containerColor = LockoutColors.Surface2,
                onDismissRequest = { swapTargetExercise = null },
                title = { Text("Swap (${activeProfile.label})", color = LockoutColors.Volt) },
                text = {
                    Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                        swaps.forEach { (altName, ratio) ->
                            val convertedKg = ((target.weightKg * ratio) / 2.5f).toInt() * 2.5f
                            ObsidianCard(
                                modifier = Modifier.clickable {
                                    exercises = exercises.map {
                                        if (it.id == target.id) it.copy(name = altName, weightKg = convertedKg) else it
                                    }
                                    swapTargetExercise = null
                                }
                            ) {
                                Text(altName, color = LockoutColors.TextPrimary, fontWeight = FontWeight.Bold)
                                Text(
                                    "Suggested load: ${convertedKg} kg",
                                    color = LockoutColors.Cyan,
                                    fontSize = 12.sp
                                )
                            }
                        }
                    }
                },
                confirmButton = {
                    TextButton(onClick = { swapTargetExercise = null }) { Text("CANCEL") }
                }
            )
        }

        // Modal 3: Mesocycle Biofeedback Auto-Regulator
        if (showFeedbackDialog) {
            AlertDialog(
                containerColor = LockoutColors.Surface2,
                onDismissRequest = { showFeedbackDialog = false },
                title = { Text("Post-Session Biofeedback", color = LockoutColors.Volt) },
                text = {
                    Text(
                        "Evaluate your Quads recovery, pump, and joint comfort to auto-regulate next week's set volume.",
                        color = LockoutColors.TextSecondary,
                        fontSize = 13.sp
                    )
                },
                confirmButton = {
                    Button(
                        onClick = {
                            val prescription = LockoutIntelligenceEngine.evaluateMesocycleFeedback(
                                BiofeedbackReport("Quads", pumpScore = 2, sorenessScore = 1, jointPainScore = 0, avgRir = 2)
                            )
                            lastCoachingNote = prescription.coachingNote
                            showFeedbackDialog = false
                        },
                        colors = ButtonDefaults.buttonColors(containerColor = LockoutColors.Volt)
                    ) {
                        Text("FRESH (+1 SET)", color = LockoutColors.Canvas, fontWeight = FontWeight.Bold)
                    }
                },
                dismissButton = {
                    TextButton(
                        onClick = {
                            val prescription = LockoutIntelligenceEngine.evaluateMesocycleFeedback(
                                BiofeedbackReport("Quads", pumpScore = 1, sorenessScore = 3, jointPainScore = 2, avgRir = 0)
                            )
                            lastCoachingNote = prescription.coachingNote
                            showFeedbackDialog = false
