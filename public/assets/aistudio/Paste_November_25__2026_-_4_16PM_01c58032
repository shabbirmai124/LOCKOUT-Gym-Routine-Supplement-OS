```kotlin
package com.lockout.app.domain

import kotlin.math.pow
import kotlin.math.roundToInt

enum class GymProfile(val label: String) {
    COMMERCIAL("Commercial Gym"),
    HOME_GARAGE("Home Barbell + DB"),
    CALISTHENICS("Rings & Park"),
    HOTEL("Hotel Dumbbells")
}

enum class ConditioningMode(val label: String) {
    EMOM("EMOM"),
    TABATA("Tabata 20/10"),
    AMRAP("AMRAP")
}

data class BiofeedbackReport(
    val muscleGroup: String,
    val pumpScore: Int,       // 1 = Low, 2 = Solid, 3 = Skin-splitting
    val sorenessScore: Int,   // 1 = Fresh, 2 = Moderate, 3 = Still very sore
    val jointPainScore: Int,  // 0 = None, 1 = Mild, 2 = Moderate, 3 = Sharp
    val avgRir: Int           // Reps in Reserve (0..4)
)

data class VolumePrescription(
    val setDelta: Int,        // +1, 0, -1, or -50% deload
    val triggerDeload: Boolean,
    val coachingNote: String
)

data class PlateLoadResult(
    val barWeightKg: Float,
    val platesPerSide: List<Float>,
    val achievableTotalKg: Float
)

object LockoutIntelligenceEngine {

    /** Epley Estimated 1-Rep Max */
    fun estimate1RM(weightKg: Float, reps: Int): Float {
        if (reps <= 1) return weightKg
        return ((weightKg * (1f + reps / 30f)) * 10f).roundToInt() / 10f
    }

    /** Official DOTS Strength Score (Men's formula; toggleable for Women) */
    fun calculateDotsScore(
        totalKg: Float,
        bodyWeightKg: Float,
        isMale: Boolean = true
    ): Float {
        val bw = bodyWeightKg.toDouble().coerceIn(40.0, 210.0)
        val (a, b, c, d, e) = if (isMale) {
            listOf(-307.75076, 24.0900756, -0.1918759221, 0.0007391293, -0.000001093)
        } else {
            listOf(-57.96288, 13.6175032, -0.1126655495, 0.0005158568, -0.0000010706)
        }
        val denom = a + b * bw + c * bw.pow(2) + d * bw.pow(3) + e * bw.pow(4)
        val coeff = 500.0 / denom
        return ((totalKg * coeff) * 10.0).roundToInt() / 10f
    }

    /** Auto-Progressive Overload Next-Session Weight */
    fun prescribeNextWeight(
        currentWeightKg: Float,
        achievedReps: Int,
        targetMaxReps: Int,
        rir: Int,
        isCompound: Boolean
    ): Float {
        if (currentWeightKg <= 0f) return 0f
        return when {
            achievedReps >= targetMaxReps && rir >= 2 -> {
                currentWeightKg + if (isCompound) 2.5f else 1.25f
            }
            achievedReps < (targetMaxReps - 2) && rir == 0 -> {
                (currentWeightKg * 0.95f).roundToNearest(1.25f)
            }
            else -> currentWeightKg
        }
    }

    /** Mesocycle Biofeedback Volume Auto-Regulation (MEV -> MRV) */
    fun evaluateMesocycleFeedback(report: BiofeedbackReport): VolumePrescription {
        return when {
            report.jointPainScore >= 2 -> VolumePrescription(
                setDelta = -2,
                triggerDeload = true,
                coachingNote = "Joint irritation detected in ${report.muscleGroup}. Swap to cable/machine variation and schedule a 50% volume deload."
            )
            report.sorenessScore == 3 && report.avgRir == 0 -> VolumePrescription(
                setDelta = -1,
                triggerDeload = false,
                coachingNote = "Recovery lagging for ${report.muscleGroup}. Trim 1 working set next session to stay inside productive MRV."
            )
            report.sorenessScore <= 1 && report.pumpScore <= 2 && report.avgRir >= 2 -> VolumePrescription(
                setDelta = +1,
                triggerDeload = false,
                coachingNote = "Fully recovered with room to grow. Adding +1 working set to ${report.muscleGroup} next week."
            )
            else -> VolumePrescription(
                setDelta = 0,
                triggerDeload = false,
                coachingNote = "Sweet spot achieved for ${report.muscleGroup}. Keep sets steady and beat reps or load next session."
            )
        }
    }

    /** Visual Barbell Plate Loader Calculator */
    fun calculatePlatesPerSide(
        targetTotalKg: Float,
        barWeightKg: Float = 20f,
        availablePlates: List<Float> = listOf(25f, 20f, 15f, 10f, 5f, 2.5f, 1.25f)
    ): PlateLoadResult {
        if (targetTotalKg <= barWeightKg) {
            return PlateLoadResult(barWeightKg, emptyList(), barWeightKg)
        }
        var remainingPerSide = (targetTotalKg - barWeightKg) / 2f
        val chosen = mutableListOf<Float>()
        for (plate in availablePlates.sortedDescending()) {
            while (remainingPerSide >= plate - 0.001f) {
                chosen.add(plate)
                remainingPerSide -= plate
            }
        }
        val actualTotal = barWeightKg + (chosen.sum() * 2f)
        return PlateLoadResult(barWeightKg, chosen, actualTotal)
    }

    /** Automatic 3-Step Compound Warm-Up Ramp */
    fun generateWarmupRamp(workingWeightKg: Float): List<Pair<Float, Int>> {
        if (workingWeightKg <= 20f) return listOf(workingWeightKg to 10)
        return listOf(
            (workingWeightKg * 0.50f).roundToNearest(2.5f).coerceAtLeast(20f) to 8,
            (workingWeightKg * 0.70f).roundToNearest(2.5f).coerceAtLeast(20f) to 5,
            (workingWeightKg * 0.85f).roundToNearest(2.5f).coerceAtLeast(20f) to 2
        )
    }

    /** Clinical Supplement Interaction & Sleep Guardrail Engine */
    fun auditSupplementStack(
        supplementNames: List<String>,
        preWorkoutHour24: Int,
        bedtimeHour24: Int
    ): List<String> {
        val warnings = mutableListOf<String>()
        val lower = supplementNames.map { it.lowercase() }

        val hasZinc = lower.any { "zinc" in it }
        val hasCalciumOrIron = lower.any { "calcium" in it || "iron" in it }
        if (hasZinc && hasCalciumOrIron) {
            warnings.add("Absorption Conflict: Separate Zinc from Calcium/Iron by at least 2 hours.")
        }

        val hasCaffeine = lower.any { "caffeine" in it || "pre-workout" in it }
        val hoursBeforeBed = (bedtimeHour24 - preWorkoutHour24 + 24) % 24
        if (hasCaffeine && hoursBeforeBed in 1..8) {
            warnings.add("Sleep Guard: Taking caffeine ${hoursBeforeBed}h before bed disrupts deep recovery. Switch to stim-free L-Citrulline.")
        }

        if (lower.any { "vitamin d" in it || "omega" in it }) {
            warnings.add("Fat-Soluble Tip: Take Vitamin D3 & Omega-3 with a meal containing healthy fats for maximum uptake.")
        }

        if (lower.any { "creatine" in it }) {
            warnings.add("Hydration Boost: Creatine active — add +500 ml to your daily water target.")
        }
        return warnings
    }

    /** 1-Tap Biomechanical Smart Machine Swapper */
    fun suggestSwaps(exerciseName: String, profile: GymProfile): List<Pair<String, Float>> {
        val key = exerciseName.lowercase()
        return when {
            "bench" in key || "chest" in key -> when (profile) {
                GymProfile.CALISTHENICS -> listOf("Weighted Ring Dips" to 0.75f, "Deficit Push-Ups" to 0.5f)
                GymProfile.HOTEL -> listOf("Flat Dumbbell Press" to 0.80f, "Floor Dumbbell Press" to 0.75f)
                else -> listOf("Converging Chest Press Machine" to 0.90f, "Incline Smith Machine Press" to 0.85f, "Low-to-High Cable Fly" to 0.45f)
            }
            "squat" in key -> when (profile) {
                GymProfile.CALISTHENICS -> listOf("Pistol Squat Progression" to 0.4f, "Bulgarian Split Squat" to 0.5f)
                GymProfile.HOTEL -> listOf("Heavy Goblet Squat" to 0.45f, "DB Bulgarian Split Squat" to 0.5f)
                else -> listOf("Hack Squat Machine" to 0.95f, "45-Degree Leg Press" to 1.40f, "Smith Machine Squat" to 0.90f)
            }
            "pull" in key || "row" in key -> when (profile) {
                GymProfile.CALISTHENICS -> listOf("Ring Inverted Rows" to 0.65f, "Strict Pull-Ups" to 0.85f)
                GymProfile.HOTEL -> listOf("Single-Arm DB Row" to 0.50f, "Chest-Supported Incline DB Row" to 0.60f)
                else -> listOf("Chest-Supported T-Bar Row" to 0.85f, "Neutral-Grip Lat Pulldown" to 0.90f, "Seated Cable Row" to 0.85f)
            }
            else -> listOf("Cable Variation" to 0.75f, "Unilateral Dumbbell Variation" to 0.55f)
        }
    }

    /** Full Data Sovereignty CSV Exporter */
    fun exportWorkoutCsv(rows: List<String>): String {
        val header = "Date,Exercise,Category,WeightKg,SetsDone,TargetSets,Est1RM\n"
        return header + rows.joinToString("\n")
    }

    private fun Float.roundToNearest(step: Float): Float {
        return (this / step).roundToInt() * step
    }
}

