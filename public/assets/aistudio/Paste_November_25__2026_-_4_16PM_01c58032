@Composable
fun ActiveTrainingTab(
    exercises: List<ActiveExercise>,
    useLbs: Boolean,
    onCompleteSet: (ActiveExercise) -> Unit,
    onOpenPlates: (Float) -> Unit,
    onOpenSwap: (ActiveExercise) -> Unit
) {
    LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp)) {
        items(exercises, key = { it.id }) { ex ->
            val displayWeight = if (useLbs) "${(ex.weightKg * 2.20462f).toInt()} lbs" else "${ex.weightKg} kg"
            val isPr = ex.weightKg > ex.prWeightKg && ex.weightKg > 0f
            val isDone = ex.completedSets >= ex.targetSets
            ObsidianCard(borderColor = if (isDone) LockoutColors.Volt else LockoutColors.Border) {
                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                    Column(Modifier.weight(1f)) {
                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Text(ex.muscleGroup.uppercase(), color = LockoutColors.Cyan, fontSize = 11.sp, fontWeight = FontWeight.Bold)
                            if (isPr) {
                                Spacer(Modifier.width(6.dp))
                                Text("NEW PR", color = LockoutColors.Volt, fontSize = 10.sp, fontWeight = FontWeight.Black)
                            }
                        }
                        Text(ex.name, color = LockoutColors.TextPrimary, fontSize = 17.sp, fontWeight = FontWeight.Bold)
                        val targetText = if (ex.isIsometric) "${ex.targetSets} × ${ex.targetReps}s hold" else "${ex.targetSets} × ${ex.targetReps} reps • $displayWeight"
                        Text(targetText, color = LockoutColors.TextSecondary, fontSize = 13.sp)
                    }
                    Button(
                        onClick = { onCompleteSet(ex) },
                        modifier = Modifier.height(52.dp),
                        colors = ButtonDefaults.buttonColors(
                            containerColor = if (isDone) LockoutColors.Volt else LockoutColors.Surface2
                        )
                    ) {
                        Text(
                            "${ex.completedSets}/${ex.targetSets}",
                            color = if (isDone) LockoutColors.Canvas else LockoutColors.Volt,
                            fontWeight = FontWeight.Black
                        )
                    }
                }
                Spacer(Modifier.height(8.dp))
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    TextButton(onClick = { onOpenSwap(ex) }) {
                        Icon(Icons.Default.SwapHoriz, null, tint = LockoutColors.TextSecondary, modifier = Modifier.size(16.dp))
                        Spacer(Modifier.width(4.dp))
                        Text("Swap Machine", color = LockoutColors.TextSecondary, fontSize = 12.sp)
                    }
                    if (ex.weightKg >= 20f) {
                        TextButton(onClick = { onOpenPlates(ex.weightKg) }) {
                            Icon(Icons.Default.Calculate, null, tint = LockoutColors.Cyan, modifier = Modifier.size(16.dp))
                            Spacer(Modifier.width(4.dp))
                            Text("Plates & Warm-Up", color = LockoutColors.Cyan, fontSize = 12.sp)
                        }
                    }
                }
            }
        }
    }
}

